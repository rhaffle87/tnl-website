# TNL Studio Backend Environment Configuration Example
# backend/.env adalah sumber kebenaran tunggal untuk konfigurasi backend.
# Salin ke backend/.env, isi nilai secret secara lokal, jangan commit nilainya.
MONGO_URL=mongodb://mongodb:27017
DB_NAME=tnl
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
STORAGE_BACKEND=local
MEDIA_DIR=/data/media
# Docker Compose hostname; use redis://127.0.0.1:6379/0 for a local systemd Redis service.
REDIS_URL=redis://redis:6379/0
GOOGLE_ALLOWED_DOMAINS=its.ac.id,student.its.ac.id
GOOGLE_ALLOWED_EMAILS=
# Direct Google OIDC stays disabled until these credentials and APP_URL are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the Google console redirect URI; HTTPS except localhost.
GOOGLE_REDIRECT_URI=
SEED_ADMIN_EMAIL=admin@its.ac.id
# Hanya contoh untuk seed LOKAL; kosongkan/override di lingkungan nyata.
SEED_ADMIN_PASSWORD=
COOKIE_SECURE=false
# Session cookie / JWT signing secret (wajib diisi di lingkungan nyata).
SESSION_SECRET=
# Secret untuk menandatangani URL upload; diperlukan saat upload diaktifkan.
UPLOAD_SIGNING_SECRET=
# Newly issued upload links expire within seven days; erasure can revoke access sooner.
UPLOAD_URL_TTL_SECONDS=604800
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TNL Studio <noreply@its.ac.id>
# Optional dedicated Fernet key; otherwise derived from an existing backend secret.
MAILER_ENCRYPTION_KEY=
WORKFLOW_WORKER_ENABLED=1
WORKFLOW_WORKER_INTERVAL_SECONDS=30
MAIL_BATCH_SIZE=25
MAIL_MAX_ATTEMPTS=8
NOTIFICATION_RETENTION_DAYS=30
# Blank uses settings.retention_days.
MESSAGE_RETENTION_DAYS=
TURNSTILE_SECRET_KEY=
