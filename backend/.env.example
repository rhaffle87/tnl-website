# TNL Studio Backend Environment Configuration Example
# backend/.env adalah sumber kebenaran tunggal untuk konfigurasi backend.
# Salin ke backend/.env, isi nilai secret secara lokal, jangan commit nilainya.
MONGO_URL=mongodb://mongodb:27017
DB_NAME=tnl
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
APP_URL=http://localhost:3000
STORAGE_BACKEND=local
MEDIA_DIR=/data/media
GOOGLE_ALLOWED_DOMAINS=its.ac.id,student.its.ac.id
GOOGLE_ALLOWED_EMAILS=
SEED_ADMIN_EMAIL=admin@its.ac.id
# Hanya contoh untuk seed LOKAL; kosongkan/override di lingkungan nyata.
SEED_ADMIN_PASSWORD=
COOKIE_SECURE=false
# Session cookie / JWT signing secret (wajib diisi di lingkungan nyata).
SESSION_SECRET=
# Secret untuk menandatangani URL upload; diperlukan saat upload diaktifkan.
UPLOAD_SIGNING_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TNL Studio <noreply@its.ac.id>
TURNSTILE_SECRET_KEY=

