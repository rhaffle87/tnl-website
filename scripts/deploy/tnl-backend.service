[Unit]
Description=TNL Studio Backend API
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tnl/backend
EnvironmentFile=/opt/tnl/backend/.env
ExecStart=/opt/tnl/backend/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8001 --workers 2 --proxy-headers --forwarded-allow-ips "100.102.105.77,127.0.0.1"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
