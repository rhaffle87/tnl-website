# TNL Studio Root Environment Configuration Example
# Salin ke .env lokal, lalu isi nilai secret secara lokal. JANGAN commit nilai secret.
DB_NAME=tnl
MONGO_URL=
MEDIA_DIR=
APP_URL=
# Cookie/session signing secret untuk backend (wajib diisi di lingkungan nyata).
SESSION_SECRET=
# Secret untuk menandatangani URL upload (wajib diisi bila upload diaktifkan).
UPLOAD_SIGNING_SECRET=
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000
STORAGE_BACKEND=local
GOOGLE_ALLOWED_DOMAINS=its.ac.id,student.its.ac.id
GOOGLE_ALLOWED_EMAILS=
SEED_ADMIN_EMAIL=admin@its.ac.id
# Hanya contoh untuk seed LOKAL; kosongkan/override di lingkungan nyata.
SEED_ADMIN_PASSWORD=
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TNL Studio <noreply@its.ac.id>
TURNSTILE_SECRET_KEY=

# Feature flag Vite dibaca SAAT BUILD (bukan runtime).
# Untuk mengubahnya, build ulang frontend setelah mengubah nilai di .env.
# Flag sementara; hapus setelah fitur dirilis permanen.
VITE_FEATURE_DOOR_CHECKIN=false
VITE_FEATURE_CERTIFICATES=false
