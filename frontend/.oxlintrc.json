{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/components/admin/editor/RichTextField.tsx"
      ],
      "rules": {
        "react/only-export-components": [
          "warn",
          {
            "allowConstantExport": true,
            "allowExportNames": [
              "countWords",
              "escapeHtml",
              "htmlToPlainText",
              "isSafeHref",
              "normalizeHtml"
            ]
          }
        ]
      }
    },
    {
      "files": [
        "src/components/admin/repeaters/KeyValueMapEditor.tsx"
      ],
